# ====================
# 依赖包
# ====================
# node_modules 可以通过 npm install 重新安装
# 通常有几百MB，不应该提交
node_modules/

# ====================
# 构建产物
# ====================
# dist/ 和 build/ 是构建生成的文件
# 每次 npm run build 都会重新生成
dist/
build/

# ====================
# 环境变量（重要！）
# ====================
# 这些文件包含密码、密钥等敏感信息
# 绝对不能提交到 Git！
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ====================
# 日志文件
# ====================
# 运行时产生的日志，不需要提交
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ====================
# IDE 配置
# ====================
# 每个人的编辑器设置不同，不需要提交
.vscode/
.idea/
*.swp
*.swo
*~

# ====================
# 操作系统文件
# ====================
# Windows、Mac、Linux 自动生成的文件
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ====================
# Claude Code 配置
# ====================
# 本地 Claude 配置，不需要提交
.claude/

# ====================
# 测试覆盖率
# ====================
coverage/

# ====================
# 临时文件
# ====================
*.tmp
*.temp
.cache/
